# =============================================================================
#  KẸO GAMING SHOP — cấu hình Apache cho Hostinger
#  File này được script postbuild copy vào out/.htaccess sau mỗi lần build.
# =============================================================================

# Trang 404 do Next.js sinh ra
ErrorDocument 404 /404.html

# --- Nén nội dung (giảm ~70% dung lượng tải) --------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
  AddOutputFilterByType DEFLATE font/woff font/woff2 application/font-woff2
</IfModule>

# --- Bộ nhớ đệm trình duyệt -------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # File trong /_next/static/ có mã băm trong tên -> cache vĩnh viễn an toàn
  <FilesMatch "\.(js|css|woff2|woff)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"

  # HTML KHÔNG cache lâu, để khách luôn thấy bản mới sau khi deploy
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # --- Header bảo mật cơ bản ---
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Gộp www về một địa chỉ duy nhất ----------------------------------------
#
# Trước khi có đoạn này, keogaminggear.com và www.keogaminggear.com cùng trả về
# 200 với NỘI DUNG GIỐNG HỆT NHAU. Google coi đó là hai trang web riêng biệt:
# uy tín bị chia đôi, và cả hai bản cùng chen nhau trong kết quả tìm kiếm —
# đã thấy đúng hiện tượng này khi tra site:keogaminggear.com.
#
# 301 = "chuyển vĩnh viễn", Google sẽ dồn toàn bộ điểm về bản không www.
#
# KHÔNG ép HTTPS ở đây: Hostinger đã tự chuyển http -> https ở tầng ngoài
# (kiểm chứng: http://keogaminggear.com/ trả về 301). Thêm luật HTTPS nữa dễ
# gây vòng lặp chuyển hướng vô tận nếu máy chủ nhận request dạng http nội bộ.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Chặn truy cập file nhạy cảm -------------------------------------------
<FilesMatch "^\.(env|git)">
  Require all denied
</FilesMatch>
